# Database
DATABASE_URL="postgresql://massmailer:massmailer@localhost:5433/massmailer?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Your Name

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Initial Admin User (used by seed script)
ADMIN_EMAIL=admin@massmailer.local
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Admin

# Sending Limits
MAX_RECIPIENTS_PER_CAMPAIGN=500
EMAIL_BATCH_SIZE=5
EMAIL_BATCH_DELAY=10000
MAX_RETRIES=3

# AI Integration (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here
