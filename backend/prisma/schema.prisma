// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaigns        Campaign[]
  settings         Settings?
  hrContacts       HRContact[]
  templates        Template[]
  smtpAccounts     SmtpAccount[]
  refreshTokens    RefreshToken[]
  candidateProfile CandidateProfile?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  family    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
}

model Campaign {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  name            String
  subject         String
  body            String         @db.Text
  status          CampaignStatus @default(DRAFT)
  recipientCount  Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  pendingCount    Int            @default(0)
  openedCount     Int            @default(0)
  clickedCount    Int            @default(0)
  batchSize       Int            @default(5)
  batchDelay      Int            @default(10000)
  maxRetries      Int            @default(3)
  enableFollowUp  Boolean        @default(false)
  followUpDays    Int            @default(3)
  followUpSubject String?
  followUpBody    String?        @db.Text
  attachmentPath  String?
  attachmentName  String?
  createdBy       String         @default("")
  updatedBy       String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  recipients      Recipient[]
  emailLogs       EmailLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])
  @@index([status, createdAt])
}

model Recipient {
  id           String          @id @default(uuid())
  campaignId   String
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String?
  email        String
  company      String?
  jobTitle     String?
  phone        String?
  linkedin     String?
  status       RecipientStatus @default(PENDING)
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  openCount    Int             @default(0)
  clickCount   Int             @default(0)
  errorMessage String?
  retryCount   Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  emailLogs    EmailLog[]

  @@index([campaignId])
  @@index([email])
  @@index([status])
  @@index([campaignId, status])
  @@index([status, updatedAt])
}

model EmailLog {
  id          String    @id @default(uuid())
  recipientId String
  recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status      String
  error       String?
  createdAt   DateTime  @default(now())

  @@index([recipientId])
  @@index([campaignId])
  @@index([recipientId, campaignId])
}

model Settings {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id])
  senderName               String   @default("")
  senderEmail              String   @default("")
  phone                    String   @default("")
  linkedin                 String   @default("")
  portfolio                String   @default("")
  maxRecipientsPerCampaign Int      @default(500)
  emailBatchSize           Int      @default(5)
  emailBatchDelay          Int      @default(10000)
  maxRetries               Int      @default(3)
  updatedAt                DateTime @updatedAt
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum RecipientStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
  BOUNCED
  CANCELLED
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  DISABLED
}

model HRContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  company   String   @default("")
  email     String
  phone     String   @default("")
  location  String   @default("")
  notes     String   @default("") @db.Text
  createdBy String   @default("")
  updatedBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
}

model Template {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  subject   String
  body      String   @db.Text
  createdBy String   @default("")
  updatedBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SmtpAccount {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  name             String
  host             String
  port             Int            @default(587)
  secure           Boolean        @default(false)
  username         String
  password         String
  fromEmail        String
  fromName         String         @default("")
  dailyLimit       Int            @default(500)
  sentToday        Int            @default(0)
  isActive         Boolean        @default(true)
  status           ProviderStatus @default(ACTIVE)
  concurrencyLimit Int            @default(5)
  failureCount     Int            @default(0)
  lastFailureAt    DateTime?
  disabledUntil    DateTime?
  createdBy        String         @default("")
  updatedBy        String         @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Career Intelligence — Phase 1
// ─────────────────────────────────────────────────────────────────────────────

model CandidateProfile {
  id                  String          @id @default(uuid())
  userId              String          @unique
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline            String?
  summary             String?         @db.Text
  location            String?
  preferredLocations  String[]
  remotePreference    String?         // "remote" | "hybrid" | "onsite"
  preferredRoles      String[]
  salaryMin           Int?
  salaryMax           Int?
  noticePeriod        String?
  workAuthorization   String?
  yearsOfExperience   Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  resumes             Resume[]
  skills              CandidateSkill[]

  @@index([userId])
}

model Resume {
  id          String        @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  storageKey  String        @unique
  rawText     String?       @db.Text
  parsedData  Json?
  status      ResumeStatus  @default(UPLOADED)
  isOriginal  Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    ResumeVersion[]

  @@index([candidateId])
  @@index([status])
  @@index([candidateId, status])
}

model ResumeVersion {
  id        String   @id @default(uuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name      String
  type      String   // e.g. "original" | "optimized"
  content   Json
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([resumeId])
}

model Skill {
  id             String         @id @default(uuid())
  name           String
  normalizedName String         @unique
  category       String?
  createdAt      DateTime       @default(now())
  aliases        SkillAlias[]
  candidates     CandidateSkill[]

  @@index([normalizedName])
}

model SkillAlias {
  id      String @id @default(uuid())
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias   String @unique

  @@index([skillId])
  @@index([alias])
}

model CandidateSkill {
  candidateId  String
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency  SkillProficiency?
  years        Float?
  source       SkillSource      @default(RESUME)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@id([candidateId, skillId])
  @@index([candidateId])
  @@index([skillId])
}

// ─── Career Enums ─────────────────────────────────────────────────────────────

enum ResumeStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillSource {
  RESUME
  MANUAL
  AI
}
